# Hatchlybox Engine in the Hatchlybox Android app: Alpine Linux inside the app, the app's screens in front.
HOST=hatchlybox
HOST_NAME="Hatchlybox for Android"
# Its own ports, so it never meets another program's on the phone.
SERVE_PORT=8877
ADB_PORT=5042
# OpenCode's documented setting to run without asking (this OpenCode has no --standalone/--auto).
OPENCODE_ARGS=""
OPENCODE_PERMISSION='{"*":"allow"}'
# What the app adds around the engine: installs APKs, its home screen and launcher mode, home-screen widgets,
# themes, web apps that run inside it, and the browser's "Add to home screen".
CAPABILITIES="android-install launcher home-widgets themes web-apps browser-shortcuts"
# The systems whose builds this platform installs: the library offers Install, Update and Open for them, Export for the rest.
INSTALLS="android web"

# The phone debugs itself (wireless debugging at 127.0.0.1) and offers downloads to its own browser only.
ADB_SELF=1
SERVE_LAN=0

# proot can't isolate programs: agents run as before (agentIsolation required refuses instead).
ISOLATION=compatible
