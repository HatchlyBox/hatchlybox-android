#!/usr/bin/env python3
# deb-unpack <dir> <deb>...: the libraries of Debian packages (no dpkg here), for visual setup on Alpine.
import io, sys, tarfile, os
out = sys.argv[1]
for deb in sys.argv[2:]:
    data = open(deb, "rb").read(); p = 8
    while p < len(data):
        name = data[p:p + 16].decode().strip().rstrip("/"); size = int(data[p + 48:p + 58])
        if name.startswith("data.tar"):
            with tarfile.open(fileobj=io.BytesIO(data[p + 60:p + 60 + size])) as t:
                for m in t.getmembers():
                    n = m.name.lstrip("./")
                    for pre, dst in (("usr/lib/aarch64-linux-gnu/", "lib/"), ("lib/aarch64-linux-gnu/", "lib/"), ("usr/share/glvnd/", "share/glvnd/"), ("usr/share/X11/xkb/", "share/xkb/")):
                        if n.startswith(pre) and (m.isfile() or m.issym() or m.isdir()):
                            m.name = dst + n[len(pre):]
                            t.extract(m, out, filter="tar")
                            break
            break
        p += 60 + size + (size & 1)
