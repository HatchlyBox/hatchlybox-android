{
  "name": "Water",
  "description": "Buttons that change the state with a script: glasses of water today, reset each day",
  "size": "small",
  "data": "./count.sh 0",
  "refresh": 3600,
  "state": {
    "glasses": 0,
    "goal": 8
  },
  "ui": {
    "type": "column",
    "gap": 6,
    "children": [
      {
        "type": "header",
        "text": "Water",
        "icon": "water",
        "color": "primary"
      },
      {
        "type": "text",
        "text": "{glasses} / {goal}",
        "style": "headline"
      },
      {
        "type": "progress",
        "value": "{glasses}",
        "max": "{goal}",
        "color": "primary"
      },
      {
        "type": "spacer",
        "weight": 1
      },
      {
        "type": "row",
        "gap": 8,
        "children": [
          {
            "type": "button",
            "text": "\u2212",
            "style": "text",
            "action": {
              "run": "./count.sh -1"
            }
          },
          {
            "type": "button",
            "text": "+ glass",
            "style": "tonal",
            "action": {
              "run": "./count.sh 1"
            },
            "weight": 1
          }
        ]
      },
      {
        "type": "text",
        "text": "Daily glass count \u00b7 your personal goal",
        "style": "caption",
        "color": "muted",
        "priority": 3,
        "lines": 1
      }
    ]
  },
  "version": 4,
  "views": [
    {
      "when": "tiny",
      "title": false,
      "ui": {
        "type": "column",
        "children": [
          {
            "type": "icon",
            "name": "water",
            "color": "primary",
            "size": 22
          },
          {
            "type": "text",
            "text": "{glasses}/{goal}",
            "style": "title",
            "lines": 1
          },
          {
            "type": "button",
            "text": "+",
            "style": "tonal",
            "action": {
              "run": "./count.sh 1"
            }
          }
        ],
        "align": "center",
        "arrange": "center",
        "gap": 4
      }
    },
    {
      "when": "wide",
      "maxHeight": 170,
      "ui": {
        "type": "row",
        "children": [
          {
            "type": "icon",
            "name": "water",
            "color": "primary",
            "size": 32
          },
          {
            "type": "column",
            "children": [
              {
                "type": "text",
                "text": "{glasses} / {goal} glasses",
                "style": "title",
                "lines": 1
              },
              {
                "type": "progress",
                "value": "{glasses}",
                "max": "{goal}",
                "color": "primary"
              }
            ],
            "gap": 6,
            "weight": 1
          },
          {
            "type": "button",
            "text": "\u2212",
            "style": "text",
            "action": {
              "run": "./count.sh -1"
            }
          },
          {
            "type": "button",
            "text": "+ glass",
            "style": "tonal",
            "action": {
              "run": "./count.sh 1"
            }
          }
        ],
        "gap": 10,
        "align": "center"
      }
    }
  ]
}
